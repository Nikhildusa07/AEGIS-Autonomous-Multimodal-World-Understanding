# ==============================
# AEGIS - Root .gitignore
# ==============================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Backend ----------
backend/uploads/
backend/data/
backend/logs/

*.log

# ---------- Frontend ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/

# ---------- Temporary ----------
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- Coverage / Testing ----------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Large ML / Model Files ----------
*.pt
*.pth
*.onnx
*.h5
*.keras
*.safetensors
*.bin

# ---------- Local databases ----------
*.db
*.sqlite
*.sqlite3

# ---------- Node ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Vite ----------
.vite/

# ---------- Generated files ----------
*.pid
*.seed